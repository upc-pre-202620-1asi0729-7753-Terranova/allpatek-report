@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam shadowing false
skinparam ArrowColor #476050
skinparam RectangleBorderColor #476050
skinparam dpi 135

title Allpatek | Design-Level EventStorming: browser demo
left to right direction

rectangle "<b>Parcel management</b>\nFarmer\n<color:#175789>Command: Publish parcel</color>\n<color:#9B421D>Event: Parcel published</color>\n<color:#346334>Read model: Parcel catalog</color>" as plot #F7FAF8

rectangle "<b>Agreements management</b>\nMerchant\n<color:#175789>Command: Accept terms and request</color>\n<color:#9B421D>Event: Merchant acceptance saved</color>\n<color:#346334>Read model: Pending agreements</color>" as request #F7FAF8

rectangle "<b>Agreements management</b>\nFarmer\n<color:#175789>Command: Confirm agreement</color>\n<color:#9B421D>Event: Both acceptances saved</color>\n<color:#346334>Read model: Signed agreements</color>" as signed #F7FAF8

rectangle "<b>Tracking evidence</b>\nFarmer\n<color:#175789>Command: Submit milestone evidence</color>\n<color:#9B421D>Event: Evidence sent for review</color>\n<color:#346334>Read model: Evidence board (review)</color>" as submitted #F7FAF8

rectangle "<b>Tracking evidence</b>\nMerchant\n<color:#175789>Command: Verify evidence</color>\n<color:#9B421D>Event: Evidence verified</color>\n<color:#346334>Read model: Evidence board (verified)</color>" as verified #F7FAF8

rectangle "<b>Escrow payments (simulation)</b>\nMerchant\n<color:#175789>Command: Release milestone in vault</color>\n<color:#9B421D>Event: Release marked in demo</color>\n<color:#346334>Read model: Vault (accepted)</color>" as released #F7FAF8

plot -right-> request
request -right-> signed
request -down-> submitted : Board currently checks\nmerchant acceptance
submitted -right-> verified
verified -right-> released
signed -down-> released : Vault requires\nboth acceptances

legend bottom
  Blue: command | Orange: conceptual business event | Green: read model.
  Events label business outcomes, not runtime messages or listeners.
  This is the browser demo. Wallet opening balance is entered in the UI.
  Release requests mark evidence as accepted. No funds are transferred.
  The UI can show release success even when the write fails.
endlegend
@enduml
