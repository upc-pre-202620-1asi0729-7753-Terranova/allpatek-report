@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #476050
skinparam RectangleBorderColor #5D6D67
skinparam wrapWidth 200
skinparam dpi 135

title Allpatek | Design-Level EventStorming (allpatek-platform)
left to right direction

rectangle "Farmer" as farmer #F8BBD0
rectangle "Merchant" as merchant #F8BBD0

package "parcels" #F7FAF8 {
  rectangle "CreateParcelCommand\nUpdateParcelCommand\nDeleteParcelCommand" as parcelCmd #64B5F6
  rectangle "Parcel" as parcelAgg #FFEE58
  rectangle "GetAllParcelsQuery" as parcelQ #81C784
  rectangle "MarkParcelInProductionCommand" as markCmd #64B5F6
}

package "agreements" #F7FAF8 {
  rectangle "SaveAgreementCommand\nmerchantSigned\nfarmerSigned" as agrCmd #64B5F6
  rectangle "DeleteAgreementCommand" as agrDel #64B5F6
  rectangle "Agreement" as agrAgg #FFEE58
  rectangle "AgreementFullySignedEvent" as agrEvt #FF9800
  rectangle "AgreementFullySigned\nIntegrationEvent" as agrInt #FF9800
  rectangle "Whenever AgreementFullySignedIntegrationEvent\nthen MarkParcelInProductionCommand" as policy #CE93D8
  rectangle "GetAllAgreementsQuery" as agrQ #81C784
}

package "tracking" #F7FAF8 {
  rectangle "SaveEvidenceCommand\nstatus: review | verified | accepted" as evCmd #64B5F6
  rectangle "DeleteEvidenceCommand" as evDel #64B5F6
  rectangle "MilestoneEvidence" as evAgg #FFEE58
  rectangle "GetAllEvidenceQuery" as evQ #81C784
}

package "escrow" #F7FAF8 {
  rectangle "SaveWalletCommand" as wCmd #64B5F6
  rectangle "DeleteWalletCommand" as wDel #64B5F6
  rectangle "Wallet" as wAgg #FFEE58
  rectangle "GetAllWalletsQuery" as wQ #81C784
}

package "alerts" #F7FAF8 {
  rectangle "GetClimateAlertsQuery" as alQ #81C784
  rectangle "ClimateReading" as climate #FFEE58
}

package "shared" #F7FAF8 {
  rectangle "UpdateProfileCommand" as pCmd #64B5F6
  rectangle "Profile" as pAgg #FFEE58
  rectangle "GetAllProfilesQuery\nGetProfileByIdQuery" as pQ #81C784
}

rectangle "Open-Meteo" as meteo #F48FB1

farmer --> parcelCmd
parcelCmd --> parcelAgg
parcelAgg --> parcelQ

farmer --> agrCmd
merchant --> agrCmd
agrCmd --> agrAgg
agrDel --> agrAgg
agrAgg --> agrEvt : onFullySigned()\nif signatures.isComplete()
agrEvt --> agrInt : AgreementFullySignedEventHandler
agrInt --> policy
policy --> markCmd
markCmd --> parcelAgg : markInProduction()\nParcelStatus.in_production
agrAgg --> agrQ

farmer --> evCmd
merchant --> evCmd
evCmd --> evAgg
evDel --> evAgg
evAgg --> evQ

merchant --> wCmd
wCmd --> wAgg
wDel --> wAgg
wAgg --> wQ

farmer --> alQ
alQ --> climate
parcelAgg --> climate : ParcelsContextFacade
climate --> meteo : WeatherForecastService

farmer --> pCmd
merchant --> pCmd
pCmd --> pAgg
pAgg --> pQ

legend bottom
  Pink actor = Farmer / Merchant (Angular demo role; Spring IAM is empty)
  Blue = Command  |  Yellow = Aggregate / ClimateReading  |  Orange = event published in Spring
  Lilac = Policy  |  Green = Query  |  Hot pink = external system
  Tracking and escrow persist status fields; they do not publish domain events.
  ClimateReading is computed on GET /api/v1/alerts and is not stored.
endlegend
@enduml
