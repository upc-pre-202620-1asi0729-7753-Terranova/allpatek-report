@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #476050
skinparam dpi 140
title Allpatek | Design-Level EventStorming by bounded context

left to right direction

rectangle "Farmer\n[Actor]" as farmer #FFF2CC
rectangle "Merchant\n[Actor]" as merchant #FFF2CC
rectangle "Payment provider\n[External actor]" as provider #FFF2CC

package "Land Management" {
  rectangle "PublishPlot\n[Command]" as publish #D9EAF7
  rectangle "Plot\n[Aggregate root]" as plot #FFF2CC
  rectangle "PlotPublished\n[Domain event]" as published #F8CBAD
  rectangle "AvailablePlots\n[Read model]" as catalog #E2F0D9
  rectangle "ReservePlot\n[Command]" as reserve #D9EAF7
  rectangle "PlotReserved\n[Domain event]" as reserved #F8CBAD
}

package "Season Contracting" {
  rectangle "SubmitProposal\n[Command | US07]" as propose #D9EAF7
  rectangle "Proposal\n[Aggregate root]" as proposal #FFF2CC
  rectangle "ProposalSubmitted\n[Domain event]" as proposed #F8CBAD
  rectangle "AcceptOrCounterProposal\n[Command | US21]" as negotiate #D9EAF7
  rectangle "TermsAgreed\n[Domain event]" as agreed #F8CBAD
  rectangle "CreateTemporaryReservation\n[Policy]" as hold #E4DFEC
  rectangle "AcceptContract\n[Command | US08]" as accept #D9EAF7
  rectangle "Contract\n[Aggregate root]" as contract #FFF2CC
  rectangle "ContractAccepted\n[Domain event]" as accepted #F8CBAD
  rectangle "ActivateContract\n[Command]" as activate #D9EAF7
  rectangle "ContractActivated\n[Domain event]" as activated #F8CBAD
  rectangle "ApproveMilestone\n[Command]" as approve #D9EAF7
  rectangle "MilestoneApproved\n[Domain event]" as approved #F8CBAD
}

package "Payments and Plans" {
  rectangle "ConfirmPayment\n[Command]" as pay #D9EAF7
  rectangle "Payment\n[Aggregate root]" as payment #FFF2CC
  rectangle "PaymentConfirmed\n[Domain event]" as confirmed #F8CBAD
  rectangle "RequestPaymentRelease\n[Policy]" as release #E4DFEC
  rectangle "PaymentReleaseRequested\n[Domain event]" as releaseRequested #F8CBAD
}

package "Crop Monitoring" {
  rectangle "RecordProgress\n[Command | US04]" as record #D9EAF7
  rectangle "ProgressUpdate\n[Aggregate root]" as update #FFF2CC
  rectangle "ProgressRecorded\n[Domain event]" as recorded #F8CBAD
  rectangle "MilestoneEvidence\n[Read model]" as evidence #E2F0D9
}

package "Contract Automation (n8n)" {
  rectangle "GenerateContractPdf\n[Policy / command]" as generatePdf #E4DFEC
  rectangle "ContractPdfGenerated\n[Integration event]" as pdfGenerated #F8CBAD
  rectangle "SendContractNotification\n[Policy / command]" as notify #E4DFEC
  rectangle "ContractNotificationSent\n[Integration event]" as notified #F8CBAD
  rectangle "NotifyProgressUpdate\n[Policy / command]" as notifyProgress #E4DFEC
  rectangle "ProgressNotificationSent\n[Integration event]" as progressNotified #F8CBAD
}

farmer --> publish
publish --> plot
plot --> published
published --> catalog
merchant --> catalog
merchant --> propose
propose --> proposal
proposal --> proposed
farmer --> negotiate
proposed --> negotiate
negotiate --> agreed
agreed --> hold
hold --> reserve
reserve --> reserved
reserved --> accept
merchant --> accept
farmer --> accept
accept --> contract
contract --> accepted
provider --> pay
accepted --> pay
pay --> payment
payment --> confirmed
confirmed --> activate
activate --> activated
activated --> generatePdf
generatePdf --> pdfGenerated
pdfGenerated --> notify
notify --> notified
farmer --> record
record --> update
update --> recorded
recorded --> evidence
recorded --> notifyProgress
notifyProgress --> progressNotified
merchant --> approve
evidence --> approve
approve --> approved
approved --> release
release --> releaseRequested

legend bottom
Blue: command | Yellow: actor or aggregate root | Orange: domain/integration event
Green: read model | Purple: policy or automated reaction
Each package represents a bounded context. Cross-context arrows are explicit event reactions.
endlegend

@enduml
