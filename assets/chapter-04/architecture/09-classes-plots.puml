@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
title Allpatek | Implemented classes - Parcel Management
top to bottom direction

package "Parcel management domain" {
  class Parcel <<Aggregate Root>> {
    -id: ParcelId
    -ownerId: ProfileId
    -name: ParcelName
    -status: ParcelStatus
    -area: ParcelArea
    -location: ParcelLocation
    -soilType: SoilType
    -campaignCost: CampaignCost
    -schedule: CampaignSchedule
    -crops: Crops
    -media: ParcelMedia
    +update(command: UpdateParcelCommand): void
    +markInProduction(): void
  }

  class CampaignSchedule <<Value Object>> {
    +durationMonths: int
    +startMonth: String
  }

  class ParcelMedia <<Value Object>> {
    +imageUrl: String
    +images: List<String>
  }

  class Crops <<Value Object>> {
    +items: List<CropName>
  }

  enum ParcelStatus {
    available
    in_production
    maintenance
  }

  interface ParcelRepository <<Repository Port>> {
    +save(parcel: Parcel): Parcel
    +findById(id: String): Optional<Parcel>
    +findAll(): List<Parcel>
    +deleteById(id: String): void
  }

  Parcel *-- CampaignSchedule
  Parcel *-- ParcelMedia
  Parcel *-- Crops
  Parcel --> ParcelStatus
  ParcelRepository ..> Parcel
}

package "Persistence" {
  class ParcelRepositoryImpl <<JPA Adapter>>
  class ParcelPersistenceEntity <<JPA Entity>>

  ParcelRepositoryImpl ..> ParcelPersistenceEntity : maps via assembler
}
ParcelRepositoryImpl ..|> ParcelRepository

legend bottom
Owner is a ProfileId. Location, area and campaign cost are text values.
markInProduction() sets ParcelStatus.in_production after AgreementFullySignedIntegrationEvent.
endlegend
@enduml
