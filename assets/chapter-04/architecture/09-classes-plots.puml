@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
title Allpatek | DDD classes - Land Management
top to bottom direction

class Plot <<Aggregate Root>> {
 -id: PlotId
 -farmerId: UserId
 -name: String
 -location: GeoLocation
 -area: Area
 -soilType: String
 -crop: String
 -seasonCost: Money
 -availability: AvailabilityPeriod
 -status: PlotStatus
 -photos: List<PlotPhoto>
 --
 +publish(): void
 +reserve(period: AvailabilityPeriod): void
 +changeAvailability(period: AvailabilityPeriod): void
 +addPhoto(photo: PlotPhoto): void
}

class PlotPhoto <<Entity>> {
 -id: PlotPhotoId
 -file: StorageKey
 -isMain: Boolean
 --
 +setAsMain(): void
}

class PlotId <<Value Object>> {
 +value: Long
}
class PlotPhotoId <<Value Object>> {
 +value: Long
}
class UserId <<Value Object>> {
 +value: Long
}
class GeoLocation <<Value Object>> {
 +description: String
 +latitude: BigDecimal
 +longitude: BigDecimal
}
class Area <<Value Object>> {
 +hectares: BigDecimal
 +isPositive(): Boolean
}
class Money <<Value Object>> {
 +amount: BigDecimal
 +currency: String
 +isPositive(): Boolean
}
class AvailabilityPeriod <<Value Object>> {
 +start: LocalDate
 +end: LocalDate
 +overlaps(other: AvailabilityPeriod): Boolean
}
class StorageKey <<Value Object>> {
 +value: String
}

enum PlotStatus {
 DRAFT
 AVAILABLE
 RESERVED
 IN_PRODUCTION
 INACTIVE
}

interface PlotRepository <<Repository Port>> {
 +findById(id: PlotId): Optional<Plot>
 +save(plot: Plot): Plot
}

Plot *-- PlotId
Plot *-- UserId : farmer
Plot *-- GeoLocation
Plot *-- Area
Plot *-- Money
Plot *-- AvailabilityPeriod
Plot *-- "0..*" PlotPhoto
PlotPhoto *-- PlotPhotoId
PlotPhoto *-- StorageKey
Plot ..> PlotStatus
PlotRepository ..> Plot

legend bottom
Plot is the aggregate root. PlotPhoto can only change through Plot.
Value Objects validate location, area, money and availability rules.
endlegend
@enduml
