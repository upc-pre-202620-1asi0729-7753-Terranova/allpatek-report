@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam packageStyle rectangle
skinparam dpi 140
hide empty members
top to bottom direction
title Allpatek | Parcels - write path

package "1. Domain" as Domain #ECF6EF {
  class Parcel <<Aggregate Root>> {
    -id: ParcelId
    -ownerId: ProfileId
    -area: ParcelArea
    -crops: Crops
    +update(UpdateParcelCommand): void
    +markInProduction(): void
  }
  class CampaignSchedule <<Value Object>> {
    -durationMonths: int
    -startMonth: String
    +durationMonths(): int
  }
  interface ParcelRepository <<Repository Port>> {
    +save(Parcel): Parcel
    +findAll(): List<Parcel>
  }
  Parcel *-right-> "1" CampaignSchedule : schedule
  ParcelRepository ..> Parcel : saves and returns
  enum ParcelStatus {
    available
    in_production
    maintenance
  }
  Parcel --> "1" ParcelStatus : status
}
package "2. Application" as Application #F3F6FA {
  interface ParcelCommandService {
    +handle(UpdateParcelCommand): Result<Parcel, ApplicationError>
  }
  class ParcelCommandServiceImpl {
    +handle(UpdateParcelCommand): Result<Parcel, ApplicationError>
  }
  ParcelCommandService <|.. ParcelCommandServiceImpl
}
package "3. Interfaces (REST)" as Interfaces #FDF4E8 {
  class ParcelsController <<REST Controller>> {
    +updateParcel(String, ParcelResource, String): ResponseEntity<?>
  }
}
package "4. Infrastructure (JPA)" as Infrastructure #F6F1F8 {
  class ParcelRepositoryImpl <<Adapter>> {
    -persistenceRepository: ParcelPersistenceRepository
    +save(Parcel): Parcel
  }
  class ParcelPersistenceAssembler <<Mapper>> {
    {static} +toDomainFromPersistence(ParcelPersistenceEntity): Parcel
  }
  class ParcelPersistenceEntity <<JPA Entity>> {
    -ownerId: Long
    -status: ParcelStatus
    +getOwnerId(): Long
  }
  ParcelRepositoryImpl ..> ParcelPersistenceAssembler : converts before and after save
  ParcelPersistenceAssembler ..> ParcelPersistenceEntity : maps
}
ParcelRepository "1" <-- ParcelCommandServiceImpl : parcelRepository
ParcelRepository <|.. ParcelRepositoryImpl
ParcelCommandService "1" <-- ParcelsController : parcelCommandService
Domain -[hidden]down-> Application
Application -[hidden]down-> Interfaces

legend bottom
+ public  |  - private
Multiplicities label stored references. Dashed arrows show use or interface realization.
endlegend
@enduml
