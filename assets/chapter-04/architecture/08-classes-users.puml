@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
title Allpatek | Implemented classes - Profiles
top to bottom direction

package "Shared domain" {
  class Profile <<Aggregate Root>> {
    -id: ProfileId
    -fullName: PersonName
    -phone: PhoneNumber
    -document: IdentityDocument
    -address: StreetAddress
    -emailAddress: EmailAddress
    -company: CompanyDetails
    +update(command: UpdateProfileCommand): void
  }

  class ProfileId <<Value Object>> {
    +value: Long
    +isAssigned(): boolean
  }

  class EmailAddress <<Value Object>> {
    +address: String
  }

  class CompanyDetails <<Value Object>> {
    +company: String
    +ruc: String
    +activity: String
  }

  interface ProfileRepository <<Repository Port>> {
    +save(profile: Profile): Profile
    +findById(id: Long): Optional<Profile>
    +findByEmailAddress(email: EmailAddress): Optional<Profile>
    +findAll(): List<Profile>
  }

  Profile *-- ProfileId
  Profile *-- EmailAddress
  Profile *-- CompanyDetails
  ProfileRepository ..> Profile
}

package "Persistence" {
  class ProfileRepositoryImpl <<JPA Adapter>>
  class ProfilePersistenceEntity <<JPA Entity>>

  ProfileRepositoryImpl ..> ProfilePersistenceEntity : maps via assembler
}
ProfileRepositoryImpl ..|> ProfileRepository

legend bottom
Profiles can be read and updated over REST.
Profile creation is internal; there is no login, role enforcement or public registration in Spring.
endlegend
@enduml
