@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam packageStyle rectangle
skinparam dpi 140
hide empty members
top to bottom direction
title Allpatek | Profiles - update path

package "1. Domain" as Domain #ECF6EF {
  class Profile <<Aggregate Root>> {
    -id: ProfileId
    -fullName: PersonName
    -emailAddress: EmailAddress
    +update(UpdateProfileCommand): void
    +getEmail(): String
  }
  class CompanyDetails <<Value Object>> {
    -company: String
    -ruc: String
    +ruc(): String
  }
  interface ProfileRepository <<Repository Port>> {
    +save(Profile): Profile
    +findAll(): List<Profile>
  }
  Profile *-right-> "1" CompanyDetails : company
  ProfileRepository ..> Profile : saves and returns
}
package "2. Application" as Application #F3F6FA {
  interface ProfileCommandService {
    +handle(UpdateProfileCommand): Result<Profile, ApplicationError>
  }
  class ProfileCommandServiceImpl {
    +handle(UpdateProfileCommand): Result<Profile, ApplicationError>
  }
  ProfileCommandService <|.. ProfileCommandServiceImpl
}
package "3. Interfaces (REST)" as Interfaces #FDF4E8 {
  class ProfilesController <<REST Controller>> {
    +updateProfile(Long, UpdateProfileResource, String): ResponseEntity<?>
  }
}
package "4. Infrastructure (JPA)" as Infrastructure #F6F1F8 {
  class ProfileRepositoryImpl <<Adapter>> {
    -persistenceRepository: ProfilePersistenceRepository
    +save(Profile): Profile
  }
  class ProfilePersistenceAssembler <<Mapper>> {
    {static} +toDomainFromPersistence(ProfilePersistenceEntity): Profile
  }
  class ProfilePersistenceEntity <<JPA Entity>> {
    -fullName: String
    -emailAddress: EmailAddress
    +getFullName(): String
  }
  ProfileRepositoryImpl ..> ProfilePersistenceAssembler : converts before and after save
  ProfilePersistenceAssembler ..> ProfilePersistenceEntity : maps
}
ProfileRepository "1" <-- ProfileCommandServiceImpl : profileRepository
ProfileRepository <|.. ProfileRepositoryImpl
ProfileCommandService "1" <-- ProfilesController : profileCommandService
Domain -[hidden]down-> Application
Application -[hidden]down-> Interfaces

legend bottom
+ public  |  - private
Multiplicities label stored references. Dashed arrows show use or interface realization.
endlegend
@enduml
