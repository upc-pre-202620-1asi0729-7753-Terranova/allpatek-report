@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
title Allpatek | Classes - Users and Profiles
top to bottom direction
class User {
 -id: Long
 -fullName: String
 -email: String
 -passwordHash: String
 -role: UserRole
 -phone: String
 -locale: String
 --
+updateProfile(fullName: String, phone: String): void
}
class Review {
 -id: Long
 -contractId: Long
 -authorId: Long
 -recipientId: Long
 -score: Integer
 -comment: String
 -createdAt: Instant
 --
+publish(): void
}
enum UserRole {
FARMER
BUYER
}
User ..> UserRole : uses
interface UserRepository {
 +findById(id: Long): Optional<User>
 +save(entity: User): User
}
UserRepository ..> User : stores and retrieves
User "1" <-- "0..*" Review : authorId
User "1" <-- "0..*" Review : recipientId
legend bottom
- Private attribute | + Public operation | Diamond: owned entity
References to other modules use identifiers.
endlegend
@enduml
