@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
title Allpatek | Classes - Season Contracting
top to bottom direction
class Proposal {
 -id: Long
 -plotId: Long
 -merchantId: Long
 -farmerId: Long
 -requestedVolume: BigDecimal
 -proposedPrice: BigDecimal
 -currency: String
 -deliveryDate: LocalDate
 -terms: String
 -expiresAt: Instant
 -status: ProposalStatus
 --
+submit(): void
+counter(terms: String): void
+accept(): void
+expire(): void
}
class Reservation {
 -id: Long
 -plotId: Long
 -proposalId: Long
 -merchantId: Long
 -expiresAt: Instant
 -status: ReservationStatus
 --
+hold(): void
+confirm(): void
+release(): void
+expire(): void
}
class Contract {
 -id: Long
 -plotId: Long
 -proposalId: Long
 -reservationId: Long
 -merchantId: Long
 -farmerId: Long
 -startDate: LocalDate
 -endDate: LocalDate
 -totalAmount: BigDecimal
 -currency: String
 -terms: String
 -merchantAcceptedAt: Instant
 -farmerAcceptedAt: Instant
 -status: ContractStatus
 -documentKey: String
 -documentSentAt: Instant
 --
+accept(partyId: Long): void
+activate(): void
+complete(): void
}
class Milestone {
 -id: Long
 -contractId: Long
 -sequence: Integer
 -name: String
 -criteria: String
 -amount: BigDecimal
 -status: String
 -reviewedAt: Instant
 -reviewNote: String
 --
+submit(): void
+approve(): void
+reject(reason: String): void
}
enum ProposalStatus {
PENDING
COUNTERED
ACCEPTED
REJECTED
EXPIRED
}
enum ReservationStatus {
PENDING_PAYMENT
CONFIRMED
RELEASED
EXPIRED
}
enum ContractStatus {
PENDING_ACCEPTANCE
PENDING_PAYMENT
ACTIVE
COMPLETED
CANCELLED
}
Proposal ..> ProposalStatus : uses
Reservation ..> ReservationStatus : uses
Contract ..> ContractStatus : uses
interface ContractRepository {
 +findById(id: Long): Optional<Contract>
 +save(entity: Contract): Contract
}
ContractRepository ..> Proposal : stores and retrieves
ContractRepository ..> Reservation : stores and retrieves
ContractRepository ..> Contract : stores and retrieves
Proposal "1" --> "0..*" Reservation : proposalId
Proposal "1" --> "0..1" Contract : proposalId
Reservation "1" --> "0..1" Contract : reservationId
Contract "1" *-- "0..*" Milestone : contractId
legend bottom
- Private attribute | + Public operation | Diamond: owned entity
References to other modules use identifiers.
endlegend
@enduml
