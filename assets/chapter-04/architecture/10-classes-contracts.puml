@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam packageStyle rectangle
skinparam dpi 140
hide empty members
top to bottom direction
title Allpatek | Agreements - write path

package "1. Domain" as Domain #ECF6EF {
  class Agreement <<Aggregate Root>> {
    -id: AgreementId
    -parcelId: ParcelId
    -merchantProfileId: ProfileId
    +isFullySigned(): boolean
    +onFullySigned(): void
  }
  class ContractSignatures <<Value Object>> {
    -merchantSigned: boolean
    -farmerSigned: boolean
    +isComplete(): boolean
  }
  interface AgreementRepository <<Repository Port>> {
    +save(Agreement): Agreement
    +findAll(): List<Agreement>
  }
  Agreement *-right-> "1" ContractSignatures : signatures
  AgreementRepository ..> Agreement : saves and returns
  abstract class AbstractDomainAggregateRoot <<Shared>> {
    #registerDomainEvent(Object): void
    +domainEvents(): Collection<Object>
  }
  class AgreementFullySignedEvent <<Domain Event>> {
    -agreementId: String
    -parcelId: String
    +parcelId(): String
  }
  AbstractDomainAggregateRoot <|-- Agreement
  Agreement ..> AgreementFullySignedEvent : registers
}
package "2. Application" as Application #F3F6FA {
  interface AgreementCommandService {
    +handle(SaveAgreementCommand): Result<Agreement, ApplicationError>
  }
  class AgreementCommandServiceImpl {
    +handle(SaveAgreementCommand): Result<Agreement, ApplicationError>
  }
  AgreementCommandService <|.. AgreementCommandServiceImpl
}
package "3. Interfaces (REST)" as Interfaces #FDF4E8 {
  class AgreementsController <<REST Controller>> {
    +createAgreement(AgreementResource, String): ResponseEntity<?>
  }
}
package "4. Infrastructure (JPA)" as Infrastructure #F6F1F8 {
  class AgreementRepositoryImpl <<Adapter>> {
    -persistenceRepository: AgreementPersistenceRepository
    +save(Agreement): Agreement
  }
  class AgreementPersistenceAssembler <<Mapper>> {
    {static} +toDomainFromPersistence(AgreementPersistenceEntity): Agreement
  }
  class AgreementPersistenceEntity <<JPA Entity>> {
    -parcelId: String
    -merchantProfileId: Long
    +getParcelId(): String
  }
  AgreementRepositoryImpl ..> AgreementPersistenceAssembler : converts before and after save
  AgreementPersistenceAssembler ..> AgreementPersistenceEntity : maps
}
AgreementRepository "1" <-- AgreementCommandServiceImpl : agreementRepository
AgreementRepository <|.. AgreementRepositoryImpl
AgreementCommandService "1" <-- AgreementsController : agreementCommandService
Domain -[hidden]down-> Application
Application -[hidden]down-> Interfaces

legend bottom
+ public  |  - private  |  # protected
Multiplicities label stored references. Dashed arrows show use or interface realization.
endlegend
@enduml
