@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
title Allpatek | Implemented classes - Agreements Management
top to bottom direction

package "Agreements management domain" {
  class Agreement <<Aggregate Root>> {
    -id: AgreementId
    -parcelId: ParcelId
    -merchantName: MerchantName
    -merchantProfileId: ProfileId
    -signatures: ContractSignatures
    -createdAt: AgreementDate
    +isFullySigned(): boolean
    +onFullySigned(): void
  }

  class AgreementFullySignedEvent <<Domain Event>> {
    +agreementId: String
    +parcelId: String
    +merchantProfileId: Long
  }

  class AgreementId <<Value Object>> {
    +value: String
  }

  class ContractSignatures <<Value Object>> {
    +merchantSigned: boolean
    +farmerSigned: boolean
  }

  class AgreementDate <<Value Object>> {
    +value: String
  }

  interface AgreementRepository <<Repository Port>> {
    +save(agreement: Agreement): Agreement
    +findAll(): List<Agreement>
  }

  Agreement *-- AgreementId
  Agreement *-- ContractSignatures
  Agreement *-- AgreementDate
  Agreement ..> AgreementFullySignedEvent : onFullySigned()
  AgreementRepository ..> Agreement
}

class AgreementCommandServiceImpl <<Application Service>>
AgreementCommandServiceImpl ..> AgreementRepository : save whole aggregate

package "Persistence" {
  class AgreementRepositoryImpl <<JPA Adapter>>
  class AgreementPersistenceEntity <<JPA Entity>>

  AgreementRepositoryImpl ..> AgreementPersistenceEntity : maps via assembler
}
AgreementRepositoryImpl ..|> AgreementRepository

legend bottom
The agreement refers to Parcel and Merchant by ID.
onFullySigned() registers AgreementFullySignedEvent when ContractSignatures is complete.
No PDF, payment confirmation or identity check in Spring.
endlegend
@enduml
