@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
hide methods
hide circle
title Allpatek | MySQL - Profiles
entity "profiles" as profile {
  {field} * id: BIGINT <<PK, AUTO>>
  {field} * full_name: VARCHAR(160)
  {field} * email_address: VARCHAR(160) <<UQ>>
  {field} phone: VARCHAR(40)
  {field} document: VARCHAR(40)
  {field} address: VARCHAR(240)
  {field} company: VARCHAR(160)
  {field} ruc: VARCHAR(20)
  {field} activity: VARCHAR(160)
  {field} * created_at: DATETIME(6)
  {field} * updated_at: DATETIME(6)
}
note right of profile
  Company details are embedded.
  No separate account, role or review table.
end note
legend bottom
PK: primary key | AUTO: auto-increment | UQ: unique | *: NOT NULL
endlegend
@enduml
