@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam packageStyle rectangle
skinparam dpi 140
hide empty members
top to bottom direction
title Allpatek | Climate alerts - forecast query

package "1. Domain" as Domain #ECF6EF {
  class ClimateReading <<record>> {
    -place: ParcelCoordinates
    -weather: WeatherSnapshot
    +alerts(): List<ClimateAlert>
  }
  class ClimateAlert <<record, Value Object>> {
    -tone: AlertTone
  }
  enum WeatherCondition {
    clear
    cloudy
    fog
    rain
    snow
    storm
    {static} +fromCode(int): WeatherCondition
  }
  ClimateReading --> "1" WeatherCondition : condition
  ClimateReading ..> ClimateAlert : creates on demand
}
package "2. Application" as Application #F3F6FA {
  class ExternalProfileService <<ACL>> {
    -profilesContextFacade: ProfilesContextFacade
  }
  class ExternalParcelService <<ACL>> {
    -parcelsContextFacade: ParcelsContextFacade
    +findLocations(Long): Result<List<ParcelCoordinates>, ApplicationError>
  }
  interface ClimateQueryService {
    +handle(GetClimateAlertsQuery): Result<List<ClimateReading>, ApplicationError>
  }
  class ClimateQueryServiceImpl {
    -externalParcelService: ExternalParcelService
    +handle(GetClimateAlertsQuery): Result<List<ClimateReading>, ApplicationError>
  }
  interface WeatherForecastService <<Outbound Port>> {
    +forecast(List<ParcelCoordinates>): Result<List<ClimateReading>, ApplicationError>
  }
  ClimateQueryService <|.. ClimateQueryServiceImpl
  ClimateQueryServiceImpl --> "1" WeatherForecastService : weatherForecastService
}
package "3. Interfaces (REST)" as Interfaces #FDF4E8 {
  class AlertsController {
    -externalProfileService: ExternalProfileService
    +getAlerts(String, Authentication): ResponseEntity<?>
  }
  class ClimateReadingResourceAssembler <<Mapper>> {
    {static} +toResourceFromEntity(ClimateReading): ClimateReadingResource
  }
  AlertsController ..> ClimateReadingResourceAssembler : builds response
}
package "4. Infrastructure (HTTP)" as Infrastructure #F6F1F8 {
  class OpenMeteoWeatherForecastService <<HTTP Adapter>> {
    -restClient: RestClient
    -baseUrl: String
    +forecast(List<ParcelCoordinates>): Result<List<ClimateReading>, ApplicationError>
  }
}
interface ParcelsContextFacade <<Parcels ACL>> {
  +findLocations(Long): List<ParcelLocation>
}
ClimateReading <.. WeatherForecastService : returns
ClimateQueryServiceImpl --> "1" ExternalParcelService : finds owner locations
ClimateQueryService "1" <-- AlertsController : climateQueryService
WeatherForecastService <|.. OpenMeteoWeatherForecastService
Domain -[hidden]down-> Application
Application -[hidden]down-> Interfaces

ExternalParcelService --> "1" ParcelsContextFacade : queries
AlertsController --> "1" ExternalProfileService : resolves caller
legend bottom
+ public  |  - private
Forecasts are queried for the parcel locations. There is no local climate table.
endlegend
@enduml
