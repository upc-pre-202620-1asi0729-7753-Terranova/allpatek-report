@startuml
!pragma layout smetana
!include <C4/C4_Component>
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowColor #476050
skinparam dpi 140
title Allpatek | C4 - Landing page components

LAYOUT_TOP_DOWN()
Person(visitor, "Visitor", "Explores Allpatek or requests information")

Container_Boundary(landing, "Static landing page") {
  Component(content, "Content and navigation", "index.html", "Hero, services, milestones, reviews, plans, team and contact")
  Component(ui, "Presentation and language", "styles.css / script.js", "Responsive menu, EN/ES text and stored language")
  Component(contact, "Contact form", "index.html / script.js", "Validates input and shows request result")
  Component(videos, "Product and team videos", "Embedded iframes", "Included in the develop version")
}

Container(web, "Web application", "Angular on Netlify", "Demo entry and workspace")
System_Ext(youtube, "YouTube", "Video hosting")
System_Ext(automation, "n8n contact webhook", "Receives contact requests")

Rel(visitor, content, "Explores", "Browser")
Rel(content, ui, "Uses styles and browser behavior", "CSS / JS")
Rel(content, contact, "Plans link to contact")
Rel(content, videos, "Embeds videos")
Rel(content, web, "Navbar opens app root", "HTTPS")
Rel(videos, youtube, "Loads embedded players", "HTTPS")
Rel(contact, automation, "Submits validated contact request", "HTTPS POST / JSON")

SHOW_LEGEND()
@enduml
