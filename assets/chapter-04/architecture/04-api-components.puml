@startuml
!pragma layout smetana
!include <C4/C4_Component>
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam dpi 120
LAYOUT_TOP_DOWN()
title Allpatek | Platform REST API components
Container_Boundary(bound, "One Spring Boot application") {
  Component(iam, "IAM", "SecurityFilterChain / REST", "Accounts, roles, BCrypt and bearer tokens.")
  Component(pf, "Profiles", "Spring module", "Profile creation, current account and facade.")
  Component(pa, "Parcels", "Spring module", "Catalog and production status.")
  Component(ag, "Agreements", "Spring module", "Records acceptance and resolves the merchant.")
  Component(tr, "Tracking", "Spring module", "Registers, verifies and releases evidence.")
  Component(es, "Escrow", "Spring module", "Provisions and credits demo wallets.")
  Component(al, "Alerts", "Spring module", "Returns forecasts for the signed-in owner.")
  Component(sh, "Shared", "Shared infrastructure", "Domain events, results, REST errors and JPA bases.")
  Component(jpa, "Persistence adapters", "Spring Data JPA", "Context-specific adapters map domain objects to rows.")
}
ContainerDb(db, "MySQL", "JPA / SQL", "Mapped persistence entities.")
System_Ext(meteo, "Open-Meteo", "Forecasts by coordinates.")
Rel(iam, pf, "Looks up profile by email", "ACL / facade")
Rel(ag, pa, "Fully signed agreement", "Spring event")
Rel(pf, es, "Profile created", "Spring event")
Rel(tr, es, "Evidence released", "Spring event")
Rel(es, ag, "Looks up merchant", "ACL / facade")
Rel(al, pa, "Gets parcel locations", "ACL / facade")
Rel(al, pf, "Resolves current profile", "ACL / facade")
Rel(al, meteo, "Requests weather", "HTTPS")
Rel(jpa, db, "Persists entities", "SQL")
Rel(jpa, sh, "Uses persistence bases")
Rel(tr, sh, "Publishes aggregate events")
Rel(iam, jpa, "Stores accounts and roles")
Rel(pa, jpa, "Stores parcels")
Rel(pf, jpa, "Stores profiles")
Rel(ag, jpa, "Stores agreements")
Rel(tr, jpa, "Stores evidence")
Rel(es, jpa, "Stores wallets")
@enduml
