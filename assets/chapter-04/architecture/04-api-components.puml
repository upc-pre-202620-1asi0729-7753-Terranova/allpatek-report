@startuml
!pragma layout smetana
!include <C4/C4_Component>
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam dpi 135

title Allpatek | C4 - Spring REST API components
LAYOUT_TOP_DOWN()

Person(reviewer, "API reviewer", "Uses REST / Swagger locally.")

Container_Boundary(api, "Spring Boot REST API") {
  Component(rest, "REST adapters", "Spring MVC", "Controllers and resource assemblers. OpenAPI and /health.")
  Component(profiles, "Shared profiles", "shared", "Profile queries and updates.")
  Component(land, "Parcel management", "parcelmanagement", "Parcel aggregate and CRUD use cases.")
  Component(agreements, "Agreements management", "agreementsmanagement", "Agreement aggregate and acceptance flags.")
  Component(wallets, "Escrow payments", "escrowpayments", "Wallet aggregate with card metadata and opening amount.")
  Component(evidence, "Tracking evidence", "trackingevidence", "MilestoneEvidence aggregate and evidence status.")
  Component(alerts, "Alerts management", "alertsmanagement", "Computes climate readings for parcel locations.")
  Component(persistence, "Persistence adapters", "Spring Data JPA", "Implement repository ports and map aggregates to entities.")
}

ContainerDb(db, "Relational storage", "MySQL", "Persistent business records.")
System_Ext(weather, "Open-Meteo", "External forecast data.")

Rel(reviewer, rest, "Calls local API", "HTTP / JSON")
Rel(rest, profiles, "/profiles")
Rel(rest, land, "/parcels")
Rel(rest, agreements, "/agreements")
Rel(rest, wallets, "/wallets")
Rel(rest, evidence, "/evidence")
Rel(rest, alerts, "/alerts")

Rel(profiles, persistence, "Uses repository")
Rel(land, persistence, "Uses repository")
Rel(agreements, persistence, "Uses repository")
Rel(wallets, persistence, "Uses repository")
Rel(evidence, persistence, "Uses repository")
Rel(alerts, land, "Reads parcel locations", "ParcelsContextFacade")
Rel(alerts, weather, "Requests forecasts", "WeatherForecastService")
Rel(persistence, db, "Reads and writes", "SQL")

footer Business routes are under /api/v1. IAM is empty. No /users, real payment execution or server-side n8n hooks.
SHOW_LEGEND()
@enduml
