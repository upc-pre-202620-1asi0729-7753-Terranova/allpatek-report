@startuml
!pragma layout smetana
!include <C4/C4_Component>
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam dpi 135

title Allpatek | C4 - Spring REST API components
LAYOUT_TOP_DOWN()

Person(reviewer, "API reviewer", "Uses REST / Swagger locally.")

Container_Boundary(api, "Spring Boot REST API") {
  Component(rest, "REST adapters", "Spring MVC", "Controllers and resource assemblers. OpenAPI and /health.")
  Component(profiles, "shared", "shared", "Profile queries and UpdateProfileCommand.")
  Component(land, "parcels", "parcels", "Parcel aggregate, CRUD and MarkParcelInProductionCommand.")
  Component(agreements, "agreements", "agreements", "Agreement aggregate and AgreementFullySignedEvent.")
  Component(wallets, "escrow", "escrow", "Wallet aggregate with PaymentCard and opening amount.")
  Component(evidence, "tracking", "tracking", "MilestoneEvidence aggregate and EvidenceStatus.")
  Component(alerts, "alerts", "alerts", "GetClimateAlertsQuery and ClimateReading.")
  Component(persistence, "Persistence adapters", "Spring Data JPA", "Implement repository ports and map aggregates to entities.")
}

ContainerDb(db, "Relational storage", "MySQL", "Persistent business records.")
System_Ext(weather, "Open-Meteo", "External forecast data.")

Rel(reviewer, rest, "Calls local API", "HTTP / JSON")
Rel(rest, profiles, "/api/v1/profiles")
Rel(rest, land, "/api/v1/parcels")
Rel(rest, agreements, "/api/v1/agreements")
Rel(rest, wallets, "/api/v1/wallets")
Rel(rest, evidence, "/api/v1/evidence")
Rel(rest, alerts, "/api/v1/alerts")

Rel(profiles, persistence, "Uses repository")
Rel(land, persistence, "Uses repository")
Rel(agreements, persistence, "Uses repository")
Rel(wallets, persistence, "Uses repository")
Rel(evidence, persistence, "Uses repository")
Rel(agreements, land, "AgreementFullySignedIntegrationEvent", "MarkParcelInProductionCommand")
Rel(alerts, land, "Reads Parcel locations", "ParcelsContextFacade")
Rel(alerts, weather, "Requests forecasts", "WeatherForecastService")
Rel(persistence, db, "Reads and writes", "SQL")

footer Business routes are under /api/v1. IAM is empty. No /users, payment gateway or server-side n8n hooks.
SHOW_LEGEND()
@enduml
