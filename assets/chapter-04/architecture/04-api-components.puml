@startuml
!pragma layout smetana
!include <C4/C4_Component>
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam dpi 125
title Allpatek | Spring REST API components
LAYOUT_TOP_DOWN()

Container(web, "Allpatek Webapp", "Angular / HttpClient", "Calls the configured Render API.")
Container_Boundary(api, "Spring Boot REST API") {
  Component(rest, "REST adapters", "Spring MVC", "Controllers and assemblers for the business resources.")
  Component(profiles, "Profiles / shared", "Spring application services", "Lists and updates profile data.")
  Component(land, "Parcels", "Spring application services", "Manages listings and parcel status.")
  Component(agreements, "Agreements", "Spring application services", "Stores acceptances and signals a newly fully signed agreement.")
  Component(wallets, "Escrow", "Spring application services", "Stores wallets and their opening amounts.")
  Component(evidence, "Tracking", "Spring application services", "Stores milestone evidence and its review status.")
  Component(alerts, "Alerts", "Spring query service", "Computes readings for eligible parcels.")
  Component(persistence, "Persistence adapters", "Spring Data JPA", "Implement domain repository ports and map persistence entities.")
}
ContainerDb(db, "Application database", "MySQL", "Business records")
System_Ext(weather, "Open-Meteo", "Forecast service")

Rel(web, rest, "Calls business routes", "HTTPS /api/v1")
Rel(rest, profiles, "/profiles")
Rel(rest, land, "/parcels")
Rel(rest, agreements, "/agreements")
Rel(rest, wallets, "/wallets")
Rel(rest, evidence, "/evidence")
Rel(rest, alerts, "/alerts (available to API clients)")
Rel(profiles, persistence, "Reads and updates")
Rel(land, persistence, "Reads and writes")
Rel(agreements, persistence, "Reads and writes")
Rel(wallets, persistence, "Reads and writes")
Rel(evidence, persistence, "Reads and writes")
Rel(agreements, land, "When fully signed, mark the parcel in production", "Spring events")
Rel(alerts, land, "Reads parcel locations", "ParcelsContextFacade")
Rel(alerts, weather, "Requests forecasts", "WeatherForecastService")
Rel(persistence, db, "Reads and writes", "SQL")
footer HealthController serves / and /health. The API exposes /profiles; an account /users controller is absent.
SHOW_LEGEND()
@enduml
