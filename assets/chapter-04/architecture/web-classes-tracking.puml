@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
title Allpatek Angular SPA | Milestone evidence
package "Domain" #EAF4EA {
class MilestoneEvidence {
  +id: string
  +parcelId: string
  +agreementId: string
  +milestone: number
  +status: 'review' | 'verified' | 'accepted'
  +notes: string
  +fileName: string
}
}
package "Application" #EDF3F9 {
class EvidenceStore {
  -evidenceApi: EvidenceApi
  +evidence: Signal<MilestoneEvidence[]>
  +forParcel(parcelId: string): MilestoneEvidence[]
  +confirm(parcelId: string, milestone: number, onDone: (saved: boolean) => void): void
}
}
package "Infrastructure" #FFF6E2 {
class EvidenceApi {
  -evidenceEndpoint: EvidenceApiEndpoint
  +getEvidence(): Observable<MilestoneEvidence[]>
  +verifyEvidence(id: string): Observable<MilestoneEvidence>
  +releaseEvidence(id: string): Observable<MilestoneEvidence>
}
class EvidenceLookupApi {
  +getParcels(): Observable<EvidenceParcelRef[]>
  +getAgreements(): Observable<EvidenceAgreementRef[]>
}
}
package "Presentation" #F4EEFB {
class EvidenceReview {
  -evidence: EvidenceStore
  #confirm(): void
}
class EvidenceForm {
  -evidence: EvidenceStore
  +parcelId: InputSignal<string>
}
}
EvidenceStore -up-> "0..*" MilestoneEvidence : holds entries
EvidenceStore --> "1" EvidenceApi : saves evidence
EvidenceStore --> "1" EvidenceLookupApi : reads reference data
EvidenceReview -up-> "1" EvidenceStore : confirms milestone
EvidenceForm -up-> "1" EvidenceStore : submits evidence
@enduml
