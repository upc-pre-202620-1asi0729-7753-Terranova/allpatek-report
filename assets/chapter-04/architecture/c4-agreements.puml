@startuml
!pragma layout smetana
!include <C4/C4_Component>
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam dpi 120
LAYOUT_TOP_DOWN()

title Allpatek | C4 components - Seasonal agreements
Container_Boundary(api, "Spring REST API / agreements") {
  Component(rest, "AgreementsController", "Spring MVC", "/api/v1/agreements")
  Component(cmd, "AgreementCommandServiceImpl", "Application service", "Saves an agreement with both acceptance flags or deletes it.")
  Component(query, "AgreementQueryServiceImpl", "Application service", "Lists saved agreements and signatures.")
  Component(repo, "AgreementRepositoryImpl", "JPA adapter", "Implements AgreementRepository and maps persisted records.")
  Component(bridge, "AgreementFullySignedEventHandler", "Spring event listener", "Translates the domain event into the integration event.")
}

Component(consumer, "Parcel event handler", "Spring API / parcels", "Marks the linked parcel in production.")
ContainerDb(db, "MySQL", "Relational database", "agreements table")
Rel(rest, cmd, "POST, PUT, DELETE")
Rel(rest, query, "GET")
Rel(cmd, repo, "Writes via AgreementRepository")
Rel(query, repo, "Reads via AgreementRepository")
Rel(repo, db, "Uses AgreementPersistenceRepository", "JPA")
Rel(repo, bridge, "Newly fully signed: publishes AgreementFullySignedEvent", "DomainEventPublisher")
Rel(bridge, consumer, "AgreementFullySignedIntegrationEvent", "Spring events")
@enduml
