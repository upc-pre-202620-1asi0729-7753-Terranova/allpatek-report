@startuml
!pragma layout smetana
!include <C4/C4_Container>
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam dpi 140

title Allpatek | C4 - Demo and local backend containers
LAYOUT_TOP_DOWN()

Person(user, "Farmer / Merchant", "Uses the demo in a browser.")
Person(reviewer, "API reviewer", "Exercises endpoints locally.")

System_Boundary(allpatek, "Allpatek") {
  Container(landing, "Landing page", "HTML / CSS / JavaScript", "Describes the service and captures inquiries.")
  Container(web, "Web application (SPA)", "Angular / TypeScript", "Demo session by role: Parcel, Agreement, MilestoneEvidence, Wallet and ClimateReading.")
  Container(api, "REST API", "Java 27 / Spring Boot", "Standalone local API with OpenAPI / Swagger.")
  ContainerDb(db, "Relational storage", "MySQL 8.4 (verified locally)", "Tables: profiles, parcels, agreements, wallets and evidence.")
}

System_Ext(mock, "Demo data API", "Azure Mock API; JSON Server for local frontend development.")
System_Ext(auto, "n8n", "Browser webhook targets; workflows not verified.")
System_Ext(weather, "Open-Meteo", "Weather forecast API.")
System_Ext(maps, "OpenStreetMap", "Embedded map in the parcel form.")

Rel(user, landing, "Visits", "HTTPS")
Rel(user, web, "Uses", "HTTPS")
Rel(landing, web, "Opens web app", "Browser link")
Rel(landing, auto, "Sends contact form", "HTTP / JSON")
Rel(web, auto, "Calls contract, evidence and payout hooks", "HTTPS / JSON or form")
Rel(web, mock, "Reads and updates demo records", "HTTP / JSON")
Rel(web, weather, "Fetches forecasts directly", "HTTPS / JSON")
Rel(web, maps, "Displays parcel location", "HTTPS / iframe")
Rel(reviewer, api, "Checks endpoints and Swagger locally", "HTTP / JSON")
Rel(api, db, "Reads and persists business data", "Spring Data JPA")
Rel(api, weather, "Fetches forecasts for /alerts", "HTTPS / JSON")

footer The reviewed Angular configuration uses the mock API. An Angular-to-Spring end-to-end run was not verified.
SHOW_LEGEND()
@enduml
