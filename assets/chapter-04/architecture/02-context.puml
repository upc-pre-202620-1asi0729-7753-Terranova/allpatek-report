@startuml
!pragma layout smetana
!include <C4/C4_Context>
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam dpi 125
title Allpatek | System context
LAYOUT_TOP_DOWN()

Person(farmer, "Family farmer", "Offers parcels, accepts agreements and submits milestone evidence.")
Person(merchant, "Merchant", "Chooses a parcel, accepts terms and reviews progress.")
System(allpatek, "Allpatek", "Coordinates seasonal agreements, parcel work and milestone tracking.")
System_Ext(weather, "Open-Meteo", "Provides location-based forecasts.")
System_Ext(maps, "OpenStreetMap", "Provides an embedded parcel map.")
System_Ext(automation, "n8n", "Receives browser webhook requests.")
System_Ext(video, "YouTube", "Hosts the product and team videos.")

Rel(farmer, allpatek, "Manages parcels and records progress")
Rel(merchant, allpatek, "Contracts seasonal work and reviews evidence")
Rel(allpatek, weather, "Requests forecasts")
Rel(allpatek, maps, "Displays parcel locations")
Rel(allpatek, automation, "Requests contact and workflow notifications")
Rel(allpatek, video, "Embeds videos on the landing page")
footer Wallet and milestone release screens simulate payouts.
SHOW_LEGEND()
@enduml
