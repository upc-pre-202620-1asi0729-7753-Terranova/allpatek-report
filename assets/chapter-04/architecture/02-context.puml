@startuml
!pragma layout smetana
!include <C4/C4_Context>
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam shadowing false
skinparam dpi 140

title Allpatek | C4 - System context
LAYOUT_TOP_DOWN()

Person(farmer, "Farmer", "Creates Parcel records, signs Agreement and submits MilestoneEvidence.")
Person(merchant, "Merchant", "Chooses a Parcel, signs Agreement, reviews MilestoneEvidence and saves Wallet.")

System(allpatek, "Allpatek", "Parcel, Agreement, MilestoneEvidence, Wallet, Profile and ClimateReading. Wallet release in the browser demo is simulated.")

System_Ext(mock, "Azure Mock API", "Provides demo records and receives demo updates.")
System_Ext(weather, "Open-Meteo", "Provides location-based weather forecasts.")
System_Ext(maps, "OpenStreetMap", "Embedded parcel location map.")
System_Ext(automation, "n8n", "Browser webhook targets; workflow execution was not verified.")

Rel(farmer, allpatek, "CreateParcel and SaveEvidence")
Rel(merchant, allpatek, "SaveAgreement, SaveEvidence and SaveWallet")
Rel(allpatek, mock, "Reads and writes demo records")
Rel(allpatek, weather, "Requests forecasts")
Rel(allpatek, maps, "Loads map in parcel form")
Rel(allpatek, automation, "Submits contact and demo event requests")

footer Spring REST API and MySQL were verified separately in a local environment. No payment provider is connected.
SHOW_LEGEND()
@enduml
