@startuml
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam dpi 120
hide footbox
title Allpatek | Authenticated parcel registration and weather lookup
actor Farmer
participant "Angular SPA" as Web
participant "Parcels / REST + JPA" as P
participant "Profiles / current account or facade" as Pf
participant "Alerts / REST + application" as A
participant "Parcels facade" as Pa
participant "Open-Meteo" as Met
Farmer -> Web : Publish parcel
Web -> P : POST /api/v1/parcels (bearer, ROLE_FARMER)
P -> Pf : Resolve current profileId
P -> P : CreateParcelCommand; fall back to resource.ownerId
P --> Web : Saved parcel
Farmer -> Web : Open climate view
Web -> A : GET /api/v1/alerts (bearer)
A -> Pf : ExternalProfileService: resolve username as email
alt Profile missing
  A --> Web : Profile not found
else Profile resolved
  A -> Pa : ExternalParcelService: findLocations(ownerId)
  alt No eligible locations
    A --> Web : 200 with empty list
  else Locations returned
    A -> Met : Forecast for selected coordinates
    alt Usable response
      A -> A : Parse forecast; compute risk; assemble REST readings
      A --> Web : Climate readings
    else Provider or structure error
      A --> Web : Mapped service error
    end
  end
end
note over Web,A : ownerId is derived on the server.\nThe current AlertsApi calls the platform; the screen does not query contracts.
@enduml
