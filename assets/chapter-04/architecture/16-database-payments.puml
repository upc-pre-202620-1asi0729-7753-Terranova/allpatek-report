@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
hide methods
hide circle
title Allpatek | MySQL - Wallets
left to right direction
entity "wallets" as wallet {
  {field} * id: VARCHAR(160) <<PK>>
  --
  {field} * profile_id: BIGINT
  {field} * opening_cents: INT
  {field} * holder: VARCHAR(160)
  {field} card_number: VARCHAR(16)
  {field} cvv: VARCHAR(4)
  {field} * last4: VARCHAR(4)
  {field} * expiry: VARCHAR(5)
  {field} * brand: VARCHAR(40)
  {field} * created_at: DATETIME(6)
  {field} * updated_at: DATETIME(6)
}
entity "profiles" as profile #EAF2EB {
  {field} * id: BIGINT <<PK>>
}
profile ||..o{ wallet : profile_id
note bottom of wallet
  profile_id has no unique constraint.
  The mapping allows multiple wallets per profile.
end note
legend bottom
PK = primary key     * = NOT NULL
Crow's feet describe logical cardinalities. The schema declares no foreign keys for these IDs.
endlegend
@enduml
