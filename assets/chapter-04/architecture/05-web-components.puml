@startuml
!pragma layout smetana
!include <C4/C4_Component>
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam dpi 125
title Allpatek | Angular Webapp components
LAYOUT_TOP_DOWN()

Person(user, "Farmer or merchant", "Selects a local demo role.")
Container_Boundary(web, "Angular Webapp") {
  Component(shared, "Shared shell and profiles", "Angular Router / Signals", "Navigation, local session, profile and language.")
  Component(parcels, "parcel-management", "Angular / HttpClient", "Catalog, parcel form and details.")
  Component(agreements, "agreements-management", "Angular / HttpClient", "Records merchant and farmer acceptances.")
  Component(evidence, "tracking-evidence", "Angular / HttpClient", "Submits evidence and reviews milestones.")
  Component(escrow, "escrow-payments", "Angular / HttpClient", "Displays wallets and simulated releases.")
  Component(alerts, "alerts-management", "Angular / HttpClient", "Requests forecasts for the farmer's parcels.")
}
Container(api, "Platform REST API", "Spring Boot", "Configured Render base /api/v1")
System_Ext(weather, "Open-Meteo", "Forecast service")
System_Ext(maps, "OpenStreetMap", "Map embed")

Rel(user, shared, "Enters using /login or /register", "Browser")
Rel(shared, parcels, "/parcels", "Router")
Rel(shared, agreements, "/agreements", "Router")
Rel(shared, evidence, "/evidence", "Router")
Rel(shared, escrow, "/escrow", "Router")
Rel(shared, alerts, "/alerts", "Router")
Rel(shared, api, "Reads and updates /profiles", "HTTPS")
Rel(parcels, api, "Reads and writes /parcels", "HTTPS")
Rel(agreements, api, "Uses /agreements and /parcels", "HTTPS")
Rel(evidence, api, "Uses /evidence, /agreements and /parcels", "HTTPS")
Rel(escrow, api, "Uses /wallets and milestone records", "HTTPS")
Rel(alerts, api, "Reads /parcels", "HTTPS")
Rel(alerts, weather, "Loads forecast", "HTTPS / JSON")
Rel(parcels, maps, "Displays location", "HTTPS / iframe")
footer Optional profile-to-account sync targets /users, which Spring does not expose. Browser webhooks appear in diagram 07.
SHOW_LEGEND()
@enduml
