@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
title Allpatek | Implemented classes - Evidence and Climate
top to bottom direction

package "Tracking evidence" {
  class MilestoneEvidence <<Aggregate Root>> {
    -id: EvidenceId
    -parcelId: ParcelId
    -milestone: MilestoneNumber
    -status: EvidenceStatus
    -notes: EvidenceNotes
    -file: EvidenceFile
  }

  class MilestoneNumber <<Value Object>> {
    +value: int
  }

  class EvidenceFile <<Value Object>> {
    +fileName: String
    +image: String
  }

  enum EvidenceStatus {
    review
    verified
    accepted
  }

  interface EvidenceRepository <<Repository Port>> {
    +save(evidence: MilestoneEvidence): MilestoneEvidence
    +findAll(): List<MilestoneEvidence>
  }

  class EvidenceRepositoryImpl <<JPA Adapter>>
  class EvidencePersistenceEntity <<JPA Entity>>

  MilestoneEvidence *-- MilestoneNumber : 1 to 4
  MilestoneEvidence *-- EvidenceFile
  MilestoneEvidence --> EvidenceStatus
  EvidenceRepository ..> MilestoneEvidence
  EvidenceRepositoryImpl ..|> EvidenceRepository
  EvidenceRepositoryImpl ..> EvidencePersistenceEntity : maps via assembler
}

package "Climate alerts" {
  class ClimateQueryServiceImpl <<Application Service>>
  interface ParcelsContextFacade <<Parcel Context Port>>
  interface WeatherForecastService <<Forecast Port>>
  class OpenMeteoWeatherForecastService <<HTTP Adapter>>
  class ClimateReading <<Domain Record>> {
    +place: ParcelCoordinates
    +weather: WeatherSnapshot
    +condition: WeatherCondition
    +alerts(): List<ClimateAlert>
  }

  class ParcelCoordinates <<Value Object>> {
    +parcelId: ParcelId
    +name: AlertParcelName
    +point: GeoPoint
  }

  class ClimateAlert <<Value Object>>

  ClimateQueryServiceImpl ..> ParcelsContextFacade : parcel locations
  ClimateQueryServiceImpl ..> WeatherForecastService : requests forecasts
  WeatherForecastService ..> ClimateReading : returns readings
  OpenMeteoWeatherForecastService ..|> WeatherForecastService
  ClimateReading *-- ParcelCoordinates
  ClimateReading ..> ClimateAlert : derives alerts
}

legend bottom
Evidence is stored by parcel and milestone number. The server does not enforce status transitions.
Climate readings and alerts are computed on request using Open-Meteo; they are not persisted.
endlegend
@enduml
