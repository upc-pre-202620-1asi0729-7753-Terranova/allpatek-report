@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam packageStyle rectangle
skinparam dpi 140
hide empty members
top to bottom direction
title Allpatek | Tracking evidence - write path

package "1. Domain" as Domain #ECF6EF {
  class MilestoneEvidence <<Aggregate Root>> {
    -id: EvidenceId
    -parcelId: ParcelId
    -milestone: MilestoneNumber
    +getMilestone(): MilestoneNumber
  }
  class EvidenceFile <<Value Object>> {
    -fileName: String
    -image: String
    +fileName(): String
  }
  interface EvidenceRepository <<Repository Port>> {
    +save(MilestoneEvidence): MilestoneEvidence
    +findAll(): List<MilestoneEvidence>
  }
  MilestoneEvidence *-right-> "1" EvidenceFile : file
  EvidenceRepository ..> MilestoneEvidence : saves and returns
  enum EvidenceStatus {
    review
    verified
    accepted
  }
  MilestoneEvidence --> "1" EvidenceStatus : status
}
package "2. Application" as Application #F3F6FA {
  interface EvidenceCommandService {
    +handle(SaveEvidenceCommand): Result<MilestoneEvidence, ApplicationError>
  }
  class EvidenceCommandServiceImpl {
    +handle(SaveEvidenceCommand): Result<MilestoneEvidence, ApplicationError>
  }
  EvidenceCommandService <|.. EvidenceCommandServiceImpl
}
package "3. Interfaces (REST)" as Interfaces #FDF4E8 {
  class EvidenceController <<REST Controller>> {
    +createEvidence(EvidenceResource, String): ResponseEntity<?>
  }
}
package "4. Infrastructure (JPA)" as Infrastructure #F6F1F8 {
  class EvidenceRepositoryImpl <<Adapter>> {
    -persistenceRepository: EvidencePersistenceRepository
    +save(MilestoneEvidence): MilestoneEvidence
  }
  class EvidencePersistenceAssembler <<Mapper>> {
    {static} +toDomainFromPersistence(EvidencePersistenceEntity): MilestoneEvidence
  }
  class EvidencePersistenceEntity <<JPA Entity>> {
    -parcelId: String
    -milestone: Integer
    +getMilestone(): Integer
  }
  EvidenceRepositoryImpl ..> EvidencePersistenceAssembler : converts before and after save
  EvidencePersistenceAssembler ..> EvidencePersistenceEntity : maps
}
EvidenceRepository "1" <-- EvidenceCommandServiceImpl : evidenceRepository
EvidenceRepository <|.. EvidenceRepositoryImpl
EvidenceCommandService "1" <-- EvidenceController : evidenceCommandService
Domain -[hidden]down-> Application
Application -[hidden]down-> Interfaces

legend bottom
+ public  |  - private
Multiplicities label stored references. Dashed arrows show use or interface realization.
endlegend
@enduml
