@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
title Allpatek | DDD classes - Crop Monitoring
top to bottom direction

class ProgressUpdate <<Aggregate Root>> {
 -id: ProgressUpdateId
 -contractId: ContractId
 -milestoneId: MilestoneId
 -authorId: UserId
 -clientReference: ClientReference
 -description: String
 -evidence: Evidence
 -locationStatus: EvidenceLocationStatus
 -recordedAt: Instant
 -notificationSentAt: Instant
 --
 +record(): void
 +attachEvidence(evidence: Evidence): void
 +verifyLocation(): void
 +markNotificationSent(at: Instant): void
}

class WeatherAlert <<Aggregate Root>> {
 -id: WeatherAlertId
 -plotId: PlotId
 -observation: WeatherObservation
 -severity: AlertSeverity
 -message: String
 -createdAt: Instant
 --
 +createFrom(observation: WeatherObservation): void
}

class ProgressUpdateId <<Value Object>> {
 +value: Long
}
class WeatherAlertId <<Value Object>> {
 +value: Long
}
class ContractId <<Value Object>> {
 +value: Long
}
class MilestoneId <<Value Object>> {
 +value: Long
}
class UserId <<Value Object>> {
 +value: Long
}
class PlotId <<Value Object>> {
 +value: Long
}
class ClientReference <<Value Object>> {
 +value: String
}
class StorageKey <<Value Object>> {
 +value: String
}
class GeoLocation <<Value Object>> {
 +latitude: BigDecimal
 +longitude: BigDecimal
}
class Evidence <<Value Object>> {
 +file: StorageKey
 +location: GeoLocation
 +capturedAt: Instant
}
class WeatherObservation <<Value Object>> {
 +source: String
 +observedAt: Instant
 +temperatureCelsius: BigDecimal
 +humidityPercent: BigDecimal
}

enum EvidenceLocationStatus {
 PENDING
 VERIFIED
 REJECTED
}
enum AlertSeverity {
 INFORMATION
 WARNING
 CRITICAL
}

interface ProgressUpdateRepository <<Repository Port>> {
 +findById(id: ProgressUpdateId): Optional<ProgressUpdate>
 +findByClientReference(reference: ClientReference): Optional<ProgressUpdate>
 +save(update: ProgressUpdate): ProgressUpdate
}
interface WeatherAlertRepository <<Repository Port>> {
 +save(alert: WeatherAlert): WeatherAlert
}

ProgressUpdate *-- ProgressUpdateId
ProgressUpdate *-- ClientReference
ProgressUpdate *-- Evidence
Evidence *-- StorageKey
Evidence *-- GeoLocation
ProgressUpdate ..> EvidenceLocationStatus
WeatherAlert *-- WeatherAlertId
WeatherAlert *-- PlotId
WeatherAlert *-- WeatherObservation
WeatherAlert ..> AlertSeverity
ProgressUpdateRepository ..> ProgressUpdate
WeatherAlertRepository ..> WeatherAlert

legend bottom
ClientReference prevents duplicate offline submissions.
Evidence groups file, capture time and location as one immutable concept.
endlegend
@enduml
