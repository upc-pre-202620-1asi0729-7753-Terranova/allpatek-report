@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
hide methods
hide circle
title Allpatek | MySQL - Parcels
left to right direction
entity "parcels" as parcel {
  {field} * id: VARCHAR(160) <<PK>>
  {field} * owner_id: BIGINT
  {field} * name: VARCHAR(160)
  {field} * status: ENUM
  {field} area: VARCHAR(40)
  {field} location: VARCHAR(160)
  {field} soil_type: VARCHAR(80)
  {field} campaign_cost: VARCHAR(40)
  {field} duration_months: INT
  {field} start_month: VARCHAR(20)
  {field} crops: LONGTEXT
  {field} image_url: LONGTEXT
  {field} images: LONGTEXT
  {field} * created_at: DATETIME(6)
  {field} * updated_at: DATETIME(6)
}
entity "profiles" as profile #EAF2EB {
  {field} * id: BIGINT <<PK>>
}
parcel ..> profile : owner_id
note bottom of parcel
  {field} status: available, in_production, maintenance
  crops and images: JSON lists stored as text
  {field} location: text; climate expects lat,lon
end note
legend bottom
PK: primary key | UQ: unique | *: NOT NULL
Dashed arrows are logical references; MySQL has no foreign keys here.
endlegend
@enduml
