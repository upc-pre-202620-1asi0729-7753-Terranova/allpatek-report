@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
hide methods
hide circle
title Allpatek | MySQL - Agreements
left to right direction
entity "agreements" as agreement {
  {field} * id: VARCHAR(160) <<PK>>
  {field} * parcel_id: VARCHAR(160)
  {field} merchant_profile_id: BIGINT
  {field} merchant_name: VARCHAR(160)
  {field} * merchant_signed: BIT(1)
  {field} * farmer_signed: BIT(1)
  {field} signed_on: VARCHAR(20)
  {field} * created_at: DATETIME(6)
  {field} * updated_at: DATETIME(6)
}
entity "parcels" as parcel #EAF2EB {
  {field} * id: VARCHAR(160) <<PK>>
}
entity "profiles" as profile #EAF2EB {
  {field} * id: BIGINT <<PK>>
}
agreement ..> parcel : parcel_id
agreement ..> profile : merchant_profile_id
note bottom of agreement
  signed_on maps to API createdAt.
  No reservation, PDF, payment status or milestones table.
end note
legend bottom
PK: primary key | UQ: unique | *: NOT NULL
Dashed arrows are logical references; MySQL has no foreign keys here.
endlegend
@enduml
