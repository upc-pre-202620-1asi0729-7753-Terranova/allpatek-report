@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
hide methods
hide circle
title Allpatek | MySQL - Agreements
left to right direction
entity "agreements" as agreement {
  {field} * id: VARCHAR(160) <<PK>>
  --
  {field} * parcel_id: VARCHAR(160)
  {field} merchant_profile_id: BIGINT
  {field} merchant_name: VARCHAR(160)
  {field} * merchant_signed: BIT(1)
  {field} * farmer_signed: BIT(1)
  {field} signed_on: VARCHAR(20)
  {field} * created_at: DATETIME(6)
  {field} * updated_at: DATETIME(6)
}
entity "parcels" as parcel #EAF2EB {
  {field} * id: VARCHAR(160) <<PK>>
}
entity "profiles" as profile #EAF2EB {
  {field} * id: BIGINT <<PK>>
}
parcel ||..o{ agreement : parcel_id
profile |o..o{ agreement : merchant_profile_id
note bottom of agreement
  parcel_id is required. merchant_profile_id is optional.
  Each flag records one party's acceptance in the same row.
end note
legend bottom
PK = primary key     * = NOT NULL
Crow's feet describe logical cardinalities. The schema declares no foreign keys for these IDs.
endlegend
@enduml
