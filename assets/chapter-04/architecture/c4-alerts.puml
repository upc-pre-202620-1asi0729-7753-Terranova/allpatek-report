@startuml
!pragma layout smetana
!include <C4/C4_Component>
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam dpi 120
LAYOUT_TOP_DOWN()

title Allpatek | C4 components - Climate alerts
Container_Boundary(api, "Spring REST API / alerts") {
  Component(rest, "AlertsController", "Spring MVC", "GET /api/v1/alerts with an optional ownerId.")
  Component(query, "ClimateQueryServiceImpl", "Application service", "Builds coordinates for eligible parcels and requests current readings.")
  Component(adapter, "OpenMeteoWeatherForecastService", "HTTP adapter", "Implements WeatherForecastService and returns ClimateReading records.")
}
Component(facade, "ParcelsContextFacadeImpl", "Spring API / parcels", "Exposes parcel names and locations by owner.")
System_Ext(weather, "Open-Meteo", "External weather forecast API")

Rel(rest, query, "GetClimateAlertsQuery")
Rel(query, facade, "findLocations(ownerId)", "ParcelsContextFacade")
Rel(query, adapter, "forecast(places)", "WeatherForecastService")
Rel(adapter, weather, "Requests weather data", "HTTPS / JSON")
@enduml
