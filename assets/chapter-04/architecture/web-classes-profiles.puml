@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members
title Allpatek Angular SPA | Profiles and session
package "Domain" #EAF4EA {
interface BaseEntity {
  +id: number
}
class UserProfile {
  +id: number
  +fullName: string
  +email: string
  +company: string
}
class AccountRole <<type alias>> {
  {field} agricultor | comerciante
}
}
package "Application" #EDF3F9 {
class ProfileStore {
  -session: SessionStore
  +reload(): void
  +updateProfile(updated: UserProfile): void
}
class SessionStore {
  +enter(role: AccountRole, name: string, profileId: number | null, token: string): void
  +clear(): void
}
}
package "Infrastructure" #FFF6E2 {
class ProfileApi {
  +getMe(): Observable<UserProfile>
  +getProfiles(): Observable<UserProfile[]>
  +updateProfile(profile: UserProfile): Observable<UserProfile>
}
class UserApi {
  +signIn(email: string, password: string): Observable<AuthenticatedUserResource>
  +signUp(email: string, password: string, role: AccountRole): Observable<UserResource>
}
}
package "Presentation" #F4EEFB {
class Login {
  -session: SessionStore
  -profiles: ProfileStore
  #onSubmit(event: Event): void
}
}
BaseEntity <|.. UserProfile
SessionStore ..> AccountRole : stores role
ProfileStore -up-> "0..*" UserProfile : holds profiles
ProfileStore --> "1" ProfileApi : updates profile
Login --> "1" UserApi : sign in
ProfileStore --> "1" SessionStore : selects profile
Login -up-> "1" SessionStore : stores authenticated session
Login -up-> "1" ProfileStore : remembers profile
@enduml
