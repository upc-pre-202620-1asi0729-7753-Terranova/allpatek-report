@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 15
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
hide methods
hide circle
title Allpatek | MySQL - Evidence
left to right direction
entity "evidence" as evidence {
  {field} * id: VARCHAR(160) <<PK>>
  {field} * parcel_id: VARCHAR(160)
  {field} * milestone: INT
  {field} * status: ENUM
  {field} notes: TEXT
  {field} file_name: VARCHAR(240)
  {field} image: LONGTEXT
  {field} * created_at: DATETIME(6)
  {field} * updated_at: DATETIME(6)
}
entity "parcels" as parcel #EAF2EB {
  {field} * id: VARCHAR(160) <<PK>>
}
evidence ..> parcel : parcel_id
note bottom of evidence
  @Table(name = "evidence")
  milestone: 1 to 4 (MilestoneNumber)
  {field} status: accepted, review, verified
  REST path: /api/v1/evidence
  ClimateReading is calculated on GET /api/v1/alerts; no alerts table.
end note
legend bottom
PK: primary key | UQ: unique | *: NOT NULL
Dashed arrows are logical references; MySQL has no foreign keys here.
endlegend
@enduml
