@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam packageStyle rectangle
skinparam dpi 140
hide empty members
top to bottom direction
title Allpatek | Escrow wallets - write path

package "1. Domain" as Domain #ECF6EF {
  class Wallet <<Aggregate Root>> {
    -id: WalletId
    -profileId: ProfileId
    -openingBalance: MoneyCents
    +getOpeningBalance(): MoneyCents
  }
  class PaymentCard <<Value Object>> {
    -holder: String
    -last4: String
    +last4(): String
  }
  interface WalletRepository <<Repository Port>> {
    +save(Wallet): Wallet
    +findAll(): List<Wallet>
  }
  Wallet *-right-> "1" PaymentCard : card
  WalletRepository ..> Wallet : saves and returns
}
package "2. Application" as Application #F3F6FA {
  interface WalletCommandService {
    +handle(SaveWalletCommand): Result<Wallet, ApplicationError>
  }
  class WalletCommandServiceImpl {
    +handle(SaveWalletCommand): Result<Wallet, ApplicationError>
  }
  WalletCommandService <|.. WalletCommandServiceImpl
}
package "3. Interfaces (REST)" as Interfaces #FDF4E8 {
  class WalletsController <<REST Controller>> {
    +createWallet(WalletResource, String): ResponseEntity<?>
  }
}
package "4. Infrastructure (JPA)" as Infrastructure #F6F1F8 {
  class WalletRepositoryImpl <<Adapter>> {
    -persistenceRepository: WalletPersistenceRepository
    +save(Wallet): Wallet
  }
  class WalletPersistenceAssembler <<Mapper>> {
    {static} +toDomainFromPersistence(WalletPersistenceEntity): Wallet
  }
  class WalletPersistenceEntity <<JPA Entity>> {
    -profileId: Long
    -openingCents: Integer
    +getOpeningCents(): Integer
  }
  WalletRepositoryImpl ..> WalletPersistenceAssembler : converts before and after save
  WalletPersistenceAssembler ..> WalletPersistenceEntity : maps
}
WalletRepository "1" <-- WalletCommandServiceImpl : walletRepository
WalletRepository <|.. WalletRepositoryImpl
WalletCommandService "1" <-- WalletsController : walletCommandService
Domain -[hidden]down-> Application
Application -[hidden]down-> Interfaces

legend bottom
+ public  |  - private
Multiplicities label stored references. Dashed arrows show use or interface realization.
endlegend
@enduml
