@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
title Allpatek | Implemented classes - Wallet
top to bottom direction

package "escrow" {
  class Wallet <<Aggregate Root>> {
    -id: WalletId
    -profileId: ProfileId
    -card: PaymentCard
    -openingBalance: MoneyCents
  }

  class WalletId <<Value Object>> {
    +value: String
  }

  class PaymentCard <<Value Object>> {
    +holder: String
    +number: String
    +cvv: String
    +last4: String
    +expiry: String
    +brand: String
  }

  class MoneyCents <<Value Object>> {
    +value: int
  }

  interface WalletRepository <<Repository Port>> {
    +save(wallet: Wallet): Wallet
    +existsById(id: String): boolean
    +findAll(): List<Wallet>
    +deleteById(id: String): void
  }

  Wallet *-- WalletId
  Wallet *-- PaymentCard
  Wallet *-- MoneyCents
  WalletRepository ..> Wallet
}

class WalletCommandServiceImpl <<Application Service>>
WalletCommandServiceImpl ..> WalletRepository : SaveWalletCommand / DeleteWalletCommand

package "Persistence" {
  class WalletRepositoryImpl <<JPA Adapter>>
  class WalletPersistenceEntity <<JPA Entity>>

  WalletRepositoryImpl ..> WalletPersistenceEntity : maps via assembler
}
WalletRepositoryImpl ..|> WalletRepository

legend bottom
PaymentCard keeps holder, number, cvv, last4, expiry and brand.
WalletResource exposes number and cvv; last4 is derived from the number.
No payment gateway, movement ledger or actual release is implemented.
endlegend
@enduml
