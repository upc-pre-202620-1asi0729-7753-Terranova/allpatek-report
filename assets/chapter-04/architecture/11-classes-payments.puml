@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ArrowColor #476050
skinparam dpi 140
title Allpatek | Implemented classes - Wallet Records
top to bottom direction

package "Escrow payments domain" {
  class Wallet <<Aggregate Root>> {
    -id: WalletId
    -profileId: ProfileId
    -card: PaymentCard
    -openingBalance: MoneyCents
  }

  class WalletId <<Value Object>> {
    +value: String
  }

  class PaymentCard <<Value Object>> {
    +holder: String
    +last4: String
    +expiry: String
    +brand: String
  }

  class MoneyCents <<Value Object>> {
    +value: int
  }

  interface WalletRepository <<Repository Port>> {
    +save(wallet: Wallet): Wallet
    +findAll(): List<Wallet>
  }

  Wallet *-- WalletId
  Wallet *-- PaymentCard
  Wallet *-- MoneyCents
  WalletRepository ..> Wallet
}

class WalletCommandServiceImpl <<Application Service>>
WalletCommandServiceImpl ..> WalletRepository : save whole aggregate

package "Persistence" {
  class WalletRepositoryImpl <<JPA Adapter>>
  class WalletPersistenceEntity <<JPA Entity>>

  WalletRepositoryImpl ..> WalletPersistenceEntity : maps via assembler
}
WalletRepositoryImpl ..|> WalletRepository

legend bottom
Each record holds masked card details and a positive opening amount in cents.
No payment gateway, transaction ledger, escrow movement or actual release is implemented here.
endlegend
@enduml
