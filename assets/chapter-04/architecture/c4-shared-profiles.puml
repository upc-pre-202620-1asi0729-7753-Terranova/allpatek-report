@startuml
!pragma layout smetana
!include <C4/C4_Component>
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam dpi 120
LAYOUT_TOP_DOWN()

title Allpatek | C4 components - Profiles (shared)
Container_Boundary(api, "Spring REST API / shared / profiles") {
  Component(rest, "ProfilesController", "Spring MVC", "/api/v1/profiles")
  Component(cmd, "ProfileCommandServiceImpl", "Application service", "Updates an existing profile by ID.")
  Component(query, "ProfileQueryServiceImpl", "Application service", "Lists profiles or looks up one profile by ID.")
  Component(repo, "ProfileRepositoryImpl", "JPA adapter", "Implements ProfileRepository and maps persisted records.")
}

ContainerDb(db, "MySQL", "Relational database", "profiles table")
Rel(rest, cmd, "PUT")
Rel(rest, query, "GET")
Rel(cmd, repo, "Writes via ProfileRepository")
Rel(query, repo, "Reads via ProfileRepository")
Rel(repo, db, "Uses ProfilePersistenceRepository", "JPA")
@enduml
